{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "annotated-tree bash-annotator --rewrite-tool-call",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "annotated-tree bash-annotator --session-announcement",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact|fork"
      }
    ]
  }
}
