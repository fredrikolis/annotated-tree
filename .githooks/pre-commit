#!/usr/bin/env bash
# Concern: the mechanical gates every commit clears locally — annotations, then comment budget | Non-concern: the semantic review, attested in the commit message | IO: (working tree) -> pass/fail
# Enable per clone: git config core.hooksPath .githooks   Bypass: git commit --no-verify
set -euo pipefail

if [ -x target/release/annotated-tree ]; then
	run=(target/release/annotated-tree)
elif [ -x target/debug/annotated-tree ]; then
	run=(target/debug/annotated-tree)
else
	run=(cargo run --quiet --)
fi

# Gate 1: annotations. Twice, because the walk prunes `tests` unless --include-tests, and most
# annotations live there. --hidden is the same prune at the other end: without it nothing under
# .githooks/ or .github/ is walked. `sample/` holds deliberately-loose fixtures pinned by
# tests/golden.rs. Both lines must match .github/workflows/ci.yml and
# distribution/local-release-check.sh, or a commit this hook blocks merges green in CI.
fail_1() {
	echo "" >&2
	echo "pre-commit: ANNOTATION GATE FAILED — $1 (see above)" >&2
	exit 1
}
"${run[@]}" --strict-check . --hidden --ignore sample --max-length 200 ||
	fail_1 "a code file lacks one"
"${run[@]}" --strict-check . --hidden --ignore sample --include-tests -I 'tests/fixtures' --max-length 200 ||
	fail_1 "a file under tests/ lacks one"

# Gate 2: comment budget. Blocking comes from `level = "deny"` in the config, never from `-W`,
# which exits 1 even with zero findings. Pinned to a fork for its file-scoped rule and cached
# under target/ by rev; `set -e` fails the commit if that build fails, never a silent skip.
REV=7a232179e45414108d28047acd6315d9a2c4946b
LINT=target/lint-tools/$REV/bin/cargo-lint-extra

[ -x "$LINT" ] || cargo install --git https://github.com/fredrikolis/cargo-lint-extra --rev "$REV" --root "target/lint-tools/$REV" --quiet cargo-lint-extra >&2

"$LINT" lint-extra --config .cargo-lint-extra.toml . 1>&2 || {
	echo "" >&2
	echo "pre-commit: COMMENT GATE FAILED — what this gate does and does not measure:" >&2
	cat >&2 <<'STANDARD'
It measures size, never quality: a comment ratio and consecutive runs inside functions, the same
per file including doc comments, plus a line-length and a file-length bound. It cannot tell a good
comment from a bad one and does not try.

Tripping it is NOT an instruction to delete comments until the number passes. It asks why this
function needed a block of explanation, or why this line or file grew so long; the usual answer is
that the code is wrong, not the comment. Fix the shape: extract it, rename it, split it.

Never raise a threshold to make a file pass. The bound is the detector, and a bigger number only
hides what it found.

The bar a comment must clear to earn its space: git-agent-verdict --standards programming
STANDARD
	exit 1
}
