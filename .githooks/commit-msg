#!/usr/bin/env bash
# Concern: the gate declarations for this repo | Non-concern: how a gate is checked (git-agent-verdict owns that) or what a reviewer judges | IO: (message, tool version) -> status, edited message
# Line order IS review order: `set -e` stops at the first unattested gate, so a later gate is never
# judged against content an earlier one is still changing.
# Enable per clone: git config core.hooksPath .githooks
set -euo pipefail

git agent-verdict --require-version 2.0

git agent-verdict "$1" standards --doc docs/repo-standards.md --path .
git agent-verdict "$1" annotations --simple --doc src/annotation-guide.md --path .
git agent-verdict "$1" prose --simple --doc docs/communication-style.md \
	--path README.md --path README_APPENDIX.md --path CONTRIBUTING.md
git agent-verdict "$1" changelog --simple \
	--rule "each new bullet entry is at most 2 terse half-sentences" \
	--path CHANGELOG.md
