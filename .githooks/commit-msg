#!/usr/bin/env bash
# Concern: the gate declarations for this repo | Non-concern: how a gate is checked (git-agent-verdict owns that) or what a reviewer judges | IO: (message file, installed version) -> exit status
# Line order IS review order: `set -e` stops at the first unattested gate, so a later gate is never
# judged against content an earlier one is still changing.
# Enable per clone: git config core.hooksPath .githooks
set -euo pipefail

# Fail loud and name the remedy. Without this the hook dies on `git: 'agent-verdict' is not a git
# command`, which names neither the dependency nor how to get it, and blocks every commit.
# PIN the version. The trailer format and the reviewer brief are this gate's contract, so an
# unpinned install changes what a commit must carry, and what every reviewer is handed, without
# anyone choosing that. Bump deliberately, in a commit that also clears whatever the new one finds.
GAV_VERSION=0.1.2
command -v git-agent-verdict >/dev/null 2>&1 || {
	echo "commit-msg: git-agent-verdict is not installed, so no review gate can run." >&2
	echo "  install: cargo install git-agent-verdict --version $GAV_VERSION" >&2
	exit 1
}
installed="$(git-agent-verdict --version 2>/dev/null | awk '{print $NF}' || true)"
[ "$installed" = "$GAV_VERSION" ] || {
	echo "commit-msg: git-agent-verdict ${installed:-unknown} is installed, but this repo's gates are written against $GAV_VERSION." >&2
	echo "  install: cargo install git-agent-verdict --version $GAV_VERSION" >&2
	exit 1
}

git agent-verdict "$1" standards \
	--doc docs/repo-standards.md \
	--path .

git agent-verdict "$1" annotations --per-file \
	--doc src/annotation-guide.md \
	--path .

git agent-verdict "$1" prose \
	--doc docs/communication-style.md \
	--path README.md --path README_APPENDIX.md --path CONTRIBUTING.md
